# Required on Vercel → Project → Settings → Environment Variables
# Use your live domain (apex redirects to www on Vercel)
# NEVER set http://localhost:3000 in Production — it breaks SEO and locale links
NEXT_PUBLIC_SITE_URL=https://www.aeroventis.ma

# Google Search Console HTML-tag verification (the content value only, not the whole meta tag).
# Set it on Vercel before the production build so metadata.verification is emitted.
NEXT_PUBLIC_GSC_VERIFICATION=
